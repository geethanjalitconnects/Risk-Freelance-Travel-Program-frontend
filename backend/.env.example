# Copy to .env and fill in. Never commit .env.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. On this machine PostgreSQL 17 listens on 5432 and PostgreSQL 18 on 5433.
DATABASE_URL=sqlite:///dev.sqlite3

# The Vite dev server
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# ---- Admin ----
# Path of the Django admin (not /admin/). Use a private, hard-to-guess path in production.
ADMIN_URL=vct-admin/
ADMIN_SESSION_SECONDS=28800
# Lock a username + IP after this many failed admin logins, for this many minutes.
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=30
# Behind a reverse proxy: number of proxies in front of Django (so the real client IP is used).
AXES_IPWARE_PROXY_COUNT=0

# ---- Phone sign-in. While DJANGO_DEBUG=True, codes are printed to the console instead of sent.
# SMS_BACKEND=yourpackage.sms.YourProviderBackend   # required in production
PHONE_DEFAULT_COUNTRY_CODE=+91
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5

# ---- Driver verification documents ----
# Required in production. Generate with: python manage.py generate_document_key
# Comma-separated; the first key encrypts, all keys decrypt (for rotation). Keep them in a
# secrets manager: losing every key makes the documents unreadable.
# DOCUMENT_ENCRYPTION_KEYS=
# Publisher bank / UPI details (a different key from the documents). Required in production.
# PAYOUT_ENCRYPTION_KEYS=
# Driver withdrawals stay off until Razorpay confirms the payout flow.
PAYOUTS_ENABLED=False
# Razorpay (TEST keys in development; never commit real values)
RAZORPAY_KEY_ID=rzp_test_change-me
RAZORPAY_KEY_SECRET=change-me
RAZORPAY_WEBHOOK_SECRET=change-me
# Bookings require a verified Razorpay payment when True.
PAYMENTS_ENABLED=False
# Route stays off until Razorpay approves it for the account.
ROUTE_ENABLED=False
# ROUTE_COOLING_HOURS=24
# ROUTE_PROFILE_CATEGORY=transport
# ROUTE_PROFILE_SUBCATEGORY=cab_hailing
# PRIVATE_MEDIA_ROOT=/srv/vconnects/private_media
DOCUMENT_MAX_BYTES=5242880
DOCUMENT_RETENTION_DAYS=30

# ---- Road distances: free key from https://openrouteservice.org (used once by fetch_route_distances)
# ORS_API_KEY=

# ---- When an admin cancels a ride: extra notifiers (comma-separated dotted paths).
# RIDE_CANCELLED_NOTIFIERS=apps.bookings.notifications.sms_ride_cancelled

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30

# ---- Admin dashboard (React app at /#/admin, API at /api/admin/) ----
# First admin, created by `python manage.py seed_admin` (skipped if the username exists).
# Placeholders only: put real values in .env, never in source control. The admin must change
# this password at first sign-in.
ADMIN_USERNAME=change-me-admin
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Signs admin tokens (separate from user tokens). Required in production: 32+ random
# characters, different from DJANGO_SECRET_KEY.
# ADMIN_JWT_SECRET=
ADMIN_JWT_MINUTES=60
# THROTTLE_ADMIN_LOGIN=10/min

# ---- Email (verification approved / rejected / re-upload requested) ----
# Development prints emails to the console. Production example (any SMTP provider):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=VConnects Travel <no-reply@example.com>
# Failed emails are retried by `manage.py retry_failed_emails` (schedule it every 5 minutes).
# EMAIL_MAX_ATTEMPTS=5
# Links in emails point to the React app.
APP_URL=http://localhost:5174
